{
  "expo": {
    "name": "Mission Winning",
    "slug": "mission-winning",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0A0C10",
    "primaryColor": "#27B07D",
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": false,
          "NSHealthUpdateUsageDescription": "Mission Winning would like to share your workout and/or body weight with Apple Health.",
          "background": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "./plugins/override-health-connect-min-version.js",
      "./plugins/android-signing.js",
      "./plugins/android-gradle-properties.js",
      "./plugins/android-react-native-feature-flags.js",
      "./plugins/android-nav-bar-contrast.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png"
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C10",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "scheme": "missionwinning",
    "android": {
      "versionCode": "project.hasProperty('BUILD_NUMBER') ? project.property('BUILD_NUMBER').toInteger() : 1",
      "version": "${project.hasProperty('DISPLAY_VERSION') ? project.property('DISPLAY_VERSION') : \"1.0.0\"}",
      "package": "com.missionwinning.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_EXERCISE_ROUTE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.liftlog.online"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/json" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "file", "mimeType": "application/octet-stream" },
            { "scheme": "file", "mimeType": "application/json" },
            { "scheme": "file", "mimeType": "text/plain" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.liftlogplan" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.liftlogplan" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#27B07D",
        "foregroundImage": "./assets/icon_foreground.png",
        "monochromeImage": "./assets/icon_monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.missionwinning.app",
      "associatedDomains": ["applinks:app.liftlog.online"],
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Mission Winning Plan",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.missionwinning.app.plan"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.missionwinning.app.plan",
            "UTTypeDescription": "Mission Winning Plan",
            "UTTypeConformsTo": ["public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["liftlogplan"]
            }
          }
        ],
        "CFBundleLocalizations": [
          "ar",
          "cs",
          "de",
          "en",
          "es",
          "fi",
          "fr",
          "hu",
          "it",
          "ko",
          "nl",
          "pl",
          "pt",
          "ru",
          "sr",
          "sv",
          "tr",
          "uk",
          "zh-hans"
        ]
      },
      "appleTeamId": "",
      "version": "$(APP_DISPLAY_VERSION)",
      "buildNumber": "$(APP_VERSION)"
    }
  }
}
